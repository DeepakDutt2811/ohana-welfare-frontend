# Local dev. In production (e.g. Neon), use the connection string from your DB
# provider's dashboard — it will include ?sslmode=require, which psycopg2 handles automatically.
DATABASE_URL=postgresql://ohana_user:ohana_pass@localhost:5432/ohana_db

# Get these from https://dashboard.razorpay.com/app/keys (use test keys to start)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated, no trailing slash. In production, set this to your Vercel domain(s),
# e.g. CORS_ORIGINS=https://ohanawelfare.vercel.app,https://www.ohanawelfare.org
CORS_ORIGINS=http://localhost:5173
